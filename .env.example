# Variables públicas del frontend (Vite)
# Ajusta según entorno de despliegue.

# Base path donde se sirve la SPA ("/" en dominio raíz, "/repo/" en GitHub Pages).
VITE_BASE_PATH=/

# URL pública canónica del sitio (sin slash final).
VITE_PUBLIC_SITE_URL=https://example.com

# Variables built-in de Vite (no se definen en .env; las inyecta el build tool).
# import.meta.env.PROD     — true en build de producción (p. ej. WebP en getProjectImageAttributes).
# import.meta.env.BASE_URL — valor de `base` en vite.config.ts (prefijo de assets públicos; alineado con VITE_BASE_PATH).
